# Configuration de la base de données
MONGODB_URI=mongodb://localhost:27017/votre_base_de_donnees
NODE_ENV=development

# JWT et sécurité
JWT_SECRET=votre_cle_secrete_jwt_super_longue_et_complexe
SESSION_SECRET=votre_cle_session_secrete

# URLs
FRONTEND_URL=http://localhost:4200
front_end=http://localhost:4200

# Stripe (paiements)
STRIPE_WEBHOOK_SECRET=votre_clé_webhook_stripe

# AWS S3
AWS_ACCESS_KEY_ID=votre_clé_access_aws
AWS_SECRET_ACCESS_KEY=votre_clé_secrète_aws
AWS_REGION=eu-west-3
AWS_S3_BUCKET=votre_nom_de_bucket

# Configuration email
EMAIL_USER=votre_email@gmail.com
EMAIL_PASSWORD=votre_mot_de_passe_email

# Facebook OAuth
FACEBOOK_APP_ID=votre_app_id_facebook
FACEBOOK_APP_SECRET=votre_app_secret_facebook
FACEBOOK_CALLBACK_URL=http://localhost:3000/auth/facebook/callback

# Google OAuth
GOOGLE_CLIENT_ID=votre_client_id_google
GOOGLE_CLIENT_SECRET=votre_client_secret_google
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
